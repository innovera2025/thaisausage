# Copy to deploy/vps.env on your local machine. Never commit deploy/vps.env.

# VPS SSH connection
VPS_HOST=your-vps-host-or-ip
VPS_PORT=22
VPS_USER=your-vps-username
# Preferred: absolute path to an SSH private key on your local machine
VPS_SSH_KEY=/absolute/path/to/private/key
# Optional fallback only if your deployment process explicitly supports password login
VPS_PASSWORD=

# Remote application paths
VPS_APP_DIR=/opt/thaisausage
VPS_CONFIG_PATH=/opt/thaisausage/config/local.json
VPS_ENV_PATH=/opt/thaisausage/.env

# SQL Server ERP connection
ERP_SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-sql-server,1433;DATABASE=your-erp-database;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=10
ERP_SQL_USER=your-readonly-sql-user
ERP_SQL_PASSWORD=your-readonly-sql-password

# Application and eVRP secrets
THAISAUSAGE_API_KEY=generate-your-internal-api-key
VRP_TOKEN=your-vrp-token

# Enable only after read-only SO dry-run verification
DRY_RUN=true
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=60
