# Copy to deploy/vps.env on your local machine. Never commit deploy/vps.env.

# VPS SSH connection
VPS_HOST=your-vps-host-or-ip
VPS_PORT=22
VPS_USER=your-vps-username
# Preferred: absolute path to an SSH private key on your local machine
VPS_SSH_KEY=/absolute/path/to/private/key
# Optional fallback only if your deployment process explicitly supports password login
VPS_PASSWORD=

# Remote application paths
VPS_APP_DIR=/opt/thaisausage
VPS_CONFIG_PATH=/opt/thaisausage/config/local.json
VPS_ENV_PATH=/opt/thaisausage/.env

# Application env file to transfer separately to the VPS.
# It contains SQL credentials and tokens; do not duplicate them here.
LOCAL_APP_ENV_FILE=.env
